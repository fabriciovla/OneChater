generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Provider {
  openai
  anthropic
  google
  groq
  openrouter
  xai
  mistral
  deepseek
}

// ─── Auth.js models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz
  image         String?
  plan          String    @default("free") // free | pro | team — gates memory cap + providers
  memoryProfile String?   @map("memory_profile") @db.Text // single free-form memory prompt, shared across every model
  lsCustomerId        String?   @map("ls_customer_id")
  lsSubscriptionId    String?   @map("ls_subscription_id")
  lsSubscriptionStatus String?  @map("ls_subscription_status") // active | cancelled | expired | past_due | on_trial
  lsCurrentPeriodEnd  DateTime? @map("ls_current_period_end") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  accounts         Account[]
  chatSessions     ChatSession[]
  providerSettings UserProviderSetting[]
  memories         Memory[]
  folders          Folder[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── App models ───────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  folderId  String?  @map("folder_id")
  title     String   @default("New conversation")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  turns  ConversationTurn[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt(sort: Desc)])
  @@map("chat_sessions")
}

// User-created folder to organize chat sessions. Chats can live in at most one
// folder; deleting a folder just unfiles its chats (SetNull), never deletes them.
model Folder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @default("New folder")
  color     String?  // accent hex, e.g. "#f97316"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ChatSession[]

  @@index([userId])
  @@map("folders")
}

model ConversationTurn {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  userMessage String   @map("user_message")
  isFusion    Boolean  @default(false) @map("is_fusion")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  session       ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses     TurnResponse[]
  fusedResponse FusedResponse?

  @@index([sessionId])
  @@index([sessionId, position])
  @@map("conversation_turns")
}

model TurnResponse {
  id        String   @id @default(cuid())
  turnId    String   @map("turn_id")
  provider  Provider
  model     String
  content   String   @default("")
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, provider])
  @@index([turnId])
  @@map("turn_responses")
}

model FusedResponse {
  id        String     @id @default(cuid())
  turnId    String     @unique @map("turn_id")
  providers Provider[]
  content   String     @default("")
  error     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@map("fused_responses")
}

model UserProviderSetting {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  provider      Provider
  apiKeyEnc     String?  @map("api_key_enc")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  selectedModel String   @map("selected_model")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_provider_settings")
}

// Cross-conversation memory: durable facts about the user, shared across
// every chat session AND every model. This is the product's core promise —
// "una memoria que viaja con vos". Injected into each provider's system prompt.
model Memory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  content   String
  category  String?  // stack | project | preference | decision | tone | other
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("memories")
}

model ProviderDefault {
  provider     Provider @id
  displayName  String   @map("display_name")
  defaultModel String   @map("default_model")
  baseUrl      String?  @map("base_url")

  @@map("provider_defaults")
}
